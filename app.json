{
  "expo": {
    "name": "VUMA",
    "slug": "vumaapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.vumastore",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vumashop.online",
              "pathPrefix": "/p/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vumastore.store",
              "pathPrefix": "/app/"
            },
            {
              "scheme": "https",
              "host": "vumastore.store",
              "pathPrefix": "/invite/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBVJ_ljFAJkbehdrXWhWabXRyV076ctR4A"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.vumastore",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:vumashop.online",
        "applinks:vumastore.store"
      ],
      "config": {
        "googleMapsApiKey": "AIzaSyBVJ_ljFAJkbehdrXWhWabXRyV076ctR4A",
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VUMA uses your location to pin your delivery address and show nearby pickup points.",
        "NSCameraUsageDescription": "Allow VUMA to use your camera to take product photos.",
        "NSPhotoLibraryUsageDescription": "Allow VUMA to access your photos to upload product images.",
        "LSApplicationQueriesSchemes": ["whatsapp", "tg", "fb"]
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VUMA to access your photos to upload product images.",
          "cameraPermission": "Allow VUMA to use your camera to take product photos.",
          "microphonePermission": "VUMA uses the microphone only when you record a video of your product."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "VUMA uses your location to pin your delivery address and show nearby pickup points."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VUMA uses Face ID so you can sign in quickly and safely."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "googleMapsApiKey": "AIzaSyBVJ_ljFAJkbehdrXWhWabXRyV076ctR4A",
      "eas": {
        "projectId": "621141ab-f046-4da8-9785-b0c952d0530e"
      }
    },
    "owner": "ndala12",
    "scheme": "vuma",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/621141ab-f046-4da8-9785-b0c952d0530e"
    }
  }
}
